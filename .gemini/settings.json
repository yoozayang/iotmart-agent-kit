{
  "mcpServers": {
    "Salesforce DX": {
      "command": "npx",
      "args": ["-y", "@salesforce/mcp", "--toolsets", "orgs,data", "--no-telemetry"],
      "env": { "SF_TARGET_ORG": "NQA" }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "devops-tracker": {
      "httpUrl": "https://iotmart-tracker.pages.dev/api/client/mcp",
      "headers": {
        "Authorization": "Bearer ${WORKSPACE_CLIENT_TOKEN}"
      }
    }
  }
}
